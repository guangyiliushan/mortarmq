// The browser main-thread entry of the client library: the JS backend
// shape only, wired through the async runtime host promise bridge.

import {
  "guangyiliushan/mortarmq/client",
  "guangyiliushan/mortarmq/protocol",
  "moonbitlang/async/js_async",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/async",
} for "test"

supported_targets = "-all+js"

options(
  link: {
    "js": {
      "exports": [
        "demo_chain",
        "state_after",
        "encode_declare",
        "encode_pub",
        "decode_incoming",
      ],
    },
  },
)
